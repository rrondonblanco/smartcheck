<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      SmartCheck Probe — manifest mínimo
      Permisos:
        - INTERNET: subir la medición al backend SmartCheck.
        - BATTERY_STATS: marca la app como interesada en batería (informativo, no requiere prompt al usuario).
      NO solicitamos: ubicación, contactos, almacenamiento, cámara, audio, ni nada más.
    -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.BATTERY_STATS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartCheckProbe">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|uiMode"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SmartCheckProbe">

            <!-- Launcher (debug y testing manual) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link smartcheck://probe?sessionId=ABC123 -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="smartcheck" android:host="probe" />
            </intent-filter>
        </activity>
    </application>
</manifest>
